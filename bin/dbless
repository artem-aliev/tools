#!/usr/bin/env python3
"""dbless — interactive Parquet/CSV viewer using DuckDB (less-like).

Usage:
    dbless file.csv
    dbless file.parquet
    dbless file.md
    dbless output/*.csv
    dbless -n 50 file.parquet

Keys:
    arrows / j k     scroll line by line
    Space / PgDn     page down
    b / PgUp         page up
    g / Home         go to top
    G / End          go to tail
    /                search forward
    ?                search backward (not implemented, use /)
    n / N            next / previous match
    .                enter SQL query (Enter to run, Esc to cancel)
    Tab              switch to next file
    h                show help
    v                open current file in vi / $EDITOR
    q                quit
"""

import argparse
import curses
import os
import re
import subprocess
import sys
import duckdb


TEXT_EXTENSIONS = {".txt", ".py", ".md", ".log", ".cfg", ".ini", ".yaml", ".yml", ".toml", ".xml", ".html", ".sql", ".sh", ".bat", ".rst", ".tex", ".css", ".js", ".ts"}
JSON_EXTENSIONS = {".json", ".jsonl", ".ndjson", ".ipynb"}


def _flatten_dict(d, parent_key="", sep="."):
    """Flatten nested dict with dot-notation keys. Lists become '[N items]' strings."""
    items = []
    for k, v in d.items():
        new_key = f"{parent_key}{sep}{k}" if parent_key else k
        if isinstance(v, dict):
            items.extend(_flatten_dict(v, new_key, sep).items())
        elif isinstance(v, list):
            if v and all(isinstance(x, dict) for x in v):
                items.append((new_key, f"[{len(v)} dicts]"))
            elif v:
                items.append((new_key, f"[{len(v)} items]"))
            else:
                items.append((new_key, "[]"))
        else:
            items.append((new_key, v))
    return dict(items)


def _collapse_str(s):
    """Replace newlines with visible symbol, truncate long strings."""
    if not isinstance(s, str):
        return s
    s = s.replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t")
    return s


def load_json(con, path, view_name):
    import json
    import pandas as pd

    with open(path) as f:
        try:
            data = json.load(f)
        except json.JSONDecodeError:
            # Try JSONL — read line by line
            f.seek(0)
            records = []
            for line in f:
                line = line.strip()
                if line:
                    records.append(json.loads(line))
            if not records:
                raise ValueError("empty file")
            df = pd.json_normalize(records)
            df.columns = [c.replace(".", "_") for c in df.columns]
            con.register(view_name, df)
            return

    if isinstance(data, list):
        if not data:
            raise ValueError("empty array")
        if all(isinstance(x, dict) for x in data):
            df = pd.json_normalize(data)
            df.columns = [c.replace(".", "_") for c in df.columns]
        else:
            # Scalar array
            df = pd.DataFrame({"value": data})
        con.register(view_name, df)
        return

    if isinstance(data, dict):
        # Check for a single array-valued key containing dicts (like ipynb "cells")
        array_keys = [k for k, v in data.items() if isinstance(v, list) and v and all(isinstance(x, dict) for x in v)]
        if len(array_keys) == 1:
            key = array_keys[0]
            df = pd.json_normalize(data[key])
            df.columns = [c.replace(".", "_") for c in df.columns]
            con.register(view_name, df)
            return

        # Flatten the top-level object
        flat = _flatten_dict(data)
        rows = [{"key": k, "value": _collapse_str(v)} for k, v in flat.items()]
        df = pd.DataFrame(rows)
        con.register(view_name, df)
        return

    raise ValueError(f"unsupported JSON root type: {type(data).__name__}")


def load_table(con, path, idx):
    ext = os.path.splitext(path)[1].lower()
    base = os.path.basename(path)
    view_name = f"t{idx}"
    if ext == ".parquet":
        con.execute(f"CREATE OR REPLACE VIEW {view_name} AS SELECT * FROM '{path}'")
    elif ext in TEXT_EXTENSIONS:
        import pandas as pd
        with open(path) as f:
            lines = [line.rstrip("\n") for line in f]
        df = pd.DataFrame({"line": lines})
        con.register(view_name, df)
    elif ext in JSON_EXTENSIONS:
        load_json(con, path, view_name)
    else:
        con.execute(
            f"CREATE OR REPLACE VIEW {view_name} AS SELECT * FROM read_csv_auto('{path}')"
        )
    cols = [r[0] for r in con.execute(f"DESCRIBE {view_name}").fetchall()]
    nrows = con.execute(f"SELECT COUNT(*) FROM {view_name}").fetchone()[0]
    return base, view_name, cols, nrows


def fetch_rows(con, view_name, offset, limit):
    return con.execute(
        f"SELECT * FROM {view_name} LIMIT {limit} OFFSET {offset}"
    ).fetchall()


def search_all(con, view_name, term):
    rows = con.execute(f"SELECT * FROM {view_name}").fetchall()
    return {i for i, r in enumerate(rows) if term.lower() in str(r).lower()}


def compute_column_widths(cols, rows_sample, screen_w, min_w=4, max_w=40, sep=2):
    ncols = len(cols)
    if ncols == 0:
        return []
    if ncols == 1:
        return [screen_w - 2]
    widths = [min(len(str(c)), max_w) for c in cols]
    for row in rows_sample[:100]:
        for j, val in enumerate(row):
            widths[j] = max(widths[j], min(len(str(val)), max_w))
    total = sum(widths) + sep * (ncols - 1)
    if total > screen_w:
        scale = (screen_w - sep * (ncols - 1)) / sum(widths)
        widths = [max(min_w, int(w * scale)) for w in widths]
    return widths


def cell_str(val, width):
    if val is None:
        return "NULL".ljust(width)
    s = str(val)
    s = s.replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t")
    if len(s) > width:
        return s[: width - 1] + ">"
    return s.ljust(width)


def _format_md_line(line, screen_w):
    """Return list of (text, attr) segments for a markdown line."""
    # Heading
    m = re.match(r'^(#{1,6})\s+(.+)$', line)
    if m:
        return [(line[:screen_w - 1], curses.A_BOLD)]

    # Todo item: "- [x] task" or "- [ ] task"
    m = re.match(r'^(\s*)- \[([ xX])\](.*)$', line)
    if m:
        indent, status, rest = m.group(1), m.group(2), m.group(3)
        checked = status.strip().lower() == 'x'
        done_mark = "[x]" if checked else "[ ]"
        head = f"{indent}- "
        segments = [(head, 0)]
        segments.append((done_mark, curses.A_BOLD))
        remain = rest[:screen_w - len(indent) - 6]
        if remain:
            segments.append((remain, 0))
        return segments

    # Code fence
    if line.strip().startswith('```'):
        return [(line[:screen_w - 1], curses.A_DIM)]

    # Pipe table — handled via _render_table_row when col_widths is available
    if line.strip().startswith('|'):
        return [(line[:screen_w - 1], 0)]

    # Blockquote
    if line.strip().startswith('>'):
        return [(line[:screen_w - 1], curses.A_DIM)]

    # Horizontal rule
    if re.match(r'^[-*_]{3,}\s*$', line):
        return [(line[:screen_w - 1], curses.A_DIM)]

    return [(line[:screen_w - 1], 0)]


def _get_cells(line):
    """Split a pipe-delimited markdown table row into cells."""
    s = line.strip()
    if s.startswith('|'):
        s = s[1:]
    if s.endswith('|'):
        s = s[:-1]
    return [c.strip() for c in s.split('|')]


def _compute_table_cols(lines):
    """Compute column widths and alignments from a table's lines.
    Returns (widths, aligns) where aligns is a list of 'l'/'c'/'r'."""
    cells_list = [_get_cells(l) for l in lines]
    ncols = max((len(c) for c in cells_list), default=0)

    aligns = ['l'] * ncols
    for cells in cells_list:
        if cells and all(re.match(r'^[-:]+$', c) for c in cells):
            for j, c in enumerate(cells):
                if c.startswith(':') and c.endswith(':'):
                    aligns[j] = 'c'
                elif c.endswith(':'):
                    aligns[j] = 'r'
            break

    widths = [3] * ncols
    for cells in cells_list:
        for j, cell in enumerate(cells):
            widths[j] = max(widths[j], len(cell) + 2)

    return widths, aligns[:ncols]


def _build_md_table_map(con, view_name):
    """Pre-compute column widths, alignments and position for every table row.
    Returns dict: line_index -> (col_widths, aligns, is_first, is_last)."""
    rows = con.execute(f"SELECT * FROM {view_name}").fetchall()
    lines = [str(r[0]) for r in rows]
    table_map = {}
    i = 0
    while i < len(lines):
        if not lines[i].strip().startswith('|'):
            i += 1
            continue
        start = i
        while i < len(lines) and lines[i].strip().startswith('|'):
            i += 1
        end = i
        col_widths, aligns = _compute_table_cols(lines[start:end])
        for j in range(start, end):
            table_map[j] = (col_widths, aligns, j == start, j == end - 1)
    return table_map


def _render_table_border(col_widths, style, screen_w):
    """Return segments for a top or bottom table border."""
    if style == 'top':
        L, C, R = '\u250c', '\u252c', '\u2510'
    else:
        L, C, R = '\u2514', '\u2534', '\u2518'

    segs = [(L, curses.A_DIM)]
    for j, w in enumerate(col_widths):
        segs.append(('\u2500' * w, curses.A_DIM))
        if j < len(col_widths) - 1:
            segs.append((C, curses.A_DIM))
    segs.append((R, curses.A_DIM))

    trimmed = []
    cx = 0
    for text, attr in segs:
        if cx >= screen_w:
            break
        chunk = text[:screen_w - cx]
        if trimmed and trimmed[-1][1] == attr:
            trimmed[-1] = (trimmed[-1][0] + chunk, attr)
        else:
            trimmed.append((chunk, attr))
        cx += len(chunk)
    return trimmed


def _render_table_row(line, col_widths, aligns, screen_w):
    """Return list of (text, attr) for an aligned markdown table row."""
    stripped = line.strip()
    cells = _get_cells(stripped)
    is_sep = bool(re.match(r'^\|[-: ]+(\|[-: ]+)*\|$', stripped))

    L, C, R = ('\u251d', '\u253f', '\u2525') if is_sep else ('\u2502', '\u2502', '\u2502')

    segs = [(L, curses.A_DIM)]
    for j, cell in enumerate(cells):
        if j >= len(col_widths):
            break
        w = col_widths[j]
        if is_sep:
            content = '\u2500' * w
        elif j < len(aligns) and aligns[j] == 'r':
            content = cell.rjust(w)
        elif j < len(aligns) and aligns[j] == 'c':
            content = cell.center(w)
        else:
            content = cell.ljust(w)
        segs.append((content, curses.A_DIM if is_sep else 0))
        if j < len(cells) - 1:
            segs.append((C, curses.A_DIM))
    segs.append((R, curses.A_DIM))

    trimmed = []
    cx = 0
    for text, attr in segs:
        if cx >= screen_w:
            break
        remain = screen_w - cx
        chunk = text[:remain]
        if trimmed and trimmed[-1][1] == attr:
            trimmed[-1] = (trimmed[-1][0] + chunk, attr)
        else:
            trimmed.append((chunk, attr))
        cx += len(chunk)
    return trimmed


class Viewer:
    def __init__(self, con, tables, file_paths=None):
        self.con = con
        self.tables = tables  # list of (filename, view_name, cols, nrows)
        self.file_paths = file_paths or []  # full paths in same order as tables
        self._md_set = {i for i, (fn, _, cols, _) in enumerate(tables)
                        if fn.endswith('.md') and cols == ['line']}
        self._md_table_map = {}
        for i, (fn, vn, cols, _) in enumerate(tables):
            if fn.endswith('.md') and cols == ['line']:
                self._md_table_map[vn] = _build_md_table_map(con, vn)
        self.idx = 0          # active table index
        self.top = 0          # scroll position
        self.col_off = 0      # horizontal scroll offset
        self.search_term = ""
        self.matches = set()
        self.status_msg = ""
        self.sql_mode = False
        self.sql_prefill = ""
        self.sql_history = []
        self.search_history = []
        self._hist_idx = -1

    @property
    def view_name(self):
        return self.tables[self.idx][1]

    @property
    def cols(self):
        return self.tables[self.idx][2]

    @property
    def nrows(self):
        return self.tables[self.idx][3]

    def do_search(self, term):
        if not term:
            return
        self.search_term = term
        self.matches = search_all(self.con, self.view_name, term)
        if self.matches:
            for m in sorted(self.matches):
                if m >= self.top:
                    self.top = m
                    return
            self.top = min(self.matches)
        else:
            self.status_msg = f"Pattern not found: {term}"

    def next_match(self):
        if not self.matches:
            return
        for m in sorted(self.matches):
            if m > self.top:
                self.top = m
                return
        self.top = min(self.matches)

    def prev_match(self):
        if not self.matches:
            return
        for m in reversed(sorted(self.matches)):
            if m < self.top:
                self.top = m
                return
        self.top = max(self.matches)

    def run_sql(self, sql):
        if not sql.strip():
            self.status_msg = "(empty query)"
            return
        try:
            result = self.con.sql(sql)
            df = result.fetchdf()
            new_name = f"sql{len(self.tables)}"
            self.con.register(new_name, df)
            self.tables.append(
                (f"SQL: {sql[:60]}", new_name, df.columns.tolist(), len(df))
            )
            self.idx = len(self.tables) - 1
            self.top = 0
            self.col_off = 0
            self.search_term = ""
            self.matches = set()
            self.status_msg = f"OK: {len(df)} rows, {len(df.columns)} cols"
        except Exception as e:
            self.status_msg = f"Error: {str(e)[:80]}"

    def render(self, stdscr):
        h, w = stdscr.getmaxyx()
        stdscr.clear()

        tab_h = 1 if len(self.tables) > 1 else 0
        header_h = 2 + tab_h
        status_h = 1
        avail = max(1, h - header_h - status_h)

        rows_data = fetch_rows(self.con, self.view_name, self.top, avail)
        col_widths = compute_column_widths(self.cols, rows_data, w)

        is_md = self.idx in self._md_set

        # --- Tab bar ---
        if len(self.tables) > 1:
            x = 0
            for i, (fname, _, _, _) in enumerate(self.tables):
                label = f" {fname[:30]} "
                attr = curses.A_REVERSE if i == self.idx else 0
                try:
                    stdscr.addstr(0, x, label[: w - x - 1], attr)
                except curses.error:
                    pass
                x += len(label)
            try:
                stdscr.addstr(0, x, " " * (w - x - 1), curses.A_REVERSE if self.idx == 0 else 0)
            except curses.error:
                pass

        # --- Info bar ---
        y = tab_h
        fname = self.tables[self.idx][0]
        info = f" {fname}  [{self.nrows:,}r x {len(self.cols)}c] "
        pos = f" {self.top + 1}-{min(self.top + avail, self.nrows):,}/{self.nrows:,} "
        rw = len(pos)
        lw = max(1, w - rw - 1)
        try:
            stdscr.addstr(y, 0, info[:lw].ljust(lw)[:lw], curses.A_REVERSE)
            stdscr.addstr(y, lw, pos[:rw], curses.A_REVERSE)
        except curses.error:
            pass

        # --- Column headers ---
        col_line = y + 1
        if not is_md:
            x = 0
            for j, col in enumerate(self.cols):
                cw = col_widths[j]
                if x >= w - 1:
                    break
                try:
                    stdscr.addstr(col_line, x, cell_str(col, min(cw, w - x - 1)), curses.A_BOLD)
                except curses.error:
                    pass
                x += cw + 2

        # --- Data rows ---
        screen_y = col_line + 1
        for i, row in enumerate(rows_data):
            if screen_y >= h - status_h:
                break
            abs_row = self.top + i
            matched = abs_row in self.matches

            if is_md:
                line = str(row[0])
                tmap = self._md_table_map.get(self.view_name, {})
                tcols = tmap.get(abs_row)
                if tcols is not None:
                    col_widths, aligns, is_first, is_last = tcols

                    # Top border before first row of a table
                    if is_first and screen_y > col_line:
                        segs = _render_table_border(col_widths, 'top', w)
                        cx2 = 0
                        for text, attr in segs:
                            try:
                                stdscr.addstr(screen_y, cx2, text, attr)
                            except curses.error:
                                pass
                            cx2 += len(text)
                        screen_y += 1
                        if screen_y >= h - status_h:
                            break

                    ry = screen_y
                    segments = _render_table_row(line, col_widths, aligns, w)
                    cx = 0
                    for text, attr in segments:
                        if matched:
                            attr |= curses.A_STANDOUT
                        try:
                            stdscr.addstr(ry, cx, text, attr)
                        except curses.error:
                            pass
                        cx += len(text)
                    screen_y += 1

                    # Row number
                    rn = str(abs_row + 1)
                    try:
                        stdscr.addstr(ry, w - len(rn) - 1, rn, curses.A_DIM)
                    except curses.error:
                        pass

                    # Bottom border after last row of a table
                    if is_last and screen_y < h - status_h:
                        segs = _render_table_border(col_widths, 'bottom', w)
                        cx2 = 0
                        for text, attr in segs:
                            try:
                                stdscr.addstr(screen_y, cx2, text, attr)
                            except curses.error:
                                pass
                            cx2 += len(text)
                        screen_y += 1
                else:
                    segments = _format_md_line(line, w)
                    cx = 0
                    for text, attr in segments:
                        if matched:
                            attr |= curses.A_STANDOUT
                        try:
                            stdscr.addstr(screen_y, cx, text, attr)
                        except curses.error:
                            pass
                        cx += len(text)
                    # Row number
                    rn = str(abs_row + 1)
                    try:
                        stdscr.addstr(screen_y, w - len(rn) - 1, rn, curses.A_DIM)
                    except curses.error:
                        pass
                    screen_y += 1
            else:
                x = 0
                for j, val in enumerate(row):
                    if x >= w - 1:
                        break
                    cw = col_widths[j]
                    try:
                        stdscr.addstr(screen_y, x, cell_str(val, min(cw, w - x - 1)),
                                      curses.A_STANDOUT if matched else 0)
                    except curses.error:
                        pass
                    x += cw + 2

                # Row number
                rn = str(abs_row + 1)
                try:
                    stdscr.addstr(screen_y, w - len(rn) - 1, rn, curses.A_DIM)
                except curses.error:
                    pass
                screen_y += 1

        # --- Status bar ---
        sy = h - 1
        parts = []
        if self.search_term:
            parts.append(f"/{self.search_term}")
            if self.matches:
                sorted_m = sorted(self.matches)
                if self.top in self.matches:
                    idx = sorted_m.index(self.top) + 1
                    parts.append(f"[match {idx}/{len(self.matches)}]")
                else:
                    parts.append(f"[{len(self.matches)} matches]")
        else:
            parts.append("q:quit  v:vi  /:search  .:sql  g:top  G:end  Tab:next  h:help")
        status = " | ".join(parts)[: w - 1]
        try:
            stdscr.addstr(sy, 0, status, curses.A_REVERSE)
        except curses.error:
            pass

        return avail


def show_help(stdscr):
    h, w = stdscr.getmaxyx()
    lines = [
        " DBLess — DuckDB Parquet/CSV Viewer (less-like) ",
        "",
        " NAVIGATION",
        "  arrows / j k    scroll line",
        "  Space / PgDn    page down",
        "  b / PgUp        page up",
        "  g / Home        go to top",
        "  G / End         go to tail",
        "",
        " SEARCH",
        "  /               enter search term (Enter to confirm)",
        "  n               next match",
        "  N               previous match",
        "",
        " SQL",
        "  .               enter SQL query (Enter to run, Esc to cancel)",
        "                   table names: t0, t1, ... (files in order)",
        "                   e.g.  SELECT * FROM t0 WHERE sharpe_ratio > 0.3",
        "",
        " FILES",
        "  Tab             next file",
        "  t0 t1 ...       switch to file by index",
        "",
        " OTHER",
        "  v               open current file in vi / $EDITOR",
        "  q               quit",
        "  Ctrl+L          redraw screen",
        "",
        " Press any key to close help",
    ]
    stdscr.clear()
    for i, line in enumerate(lines):
        if i < h:
            try:
                stdscr.addstr(i, max(0, (w - len(line)) // 2), line[: w - 1])
            except curses.error:
                pass
    stdscr.refresh()
    stdscr.get_wch()


def get_input(stdscr, prompt_y, prompt, history=None, default=""):
    """Read a line of input with editing and history. Returns string or '' on Esc."""
    h, w = stdscr.getmaxyx()
    curses.noecho()
    curses.curs_set(1)

    buf = list(default)
    pos = len(buf)
    scroll_off = 0
    hist_idx = -1
    saved_before_history = []

    def render():
        nonlocal scroll_off
        vis_w = w - len(prompt) - 1
        if pos < scroll_off:
            scroll_off = pos
        elif pos >= scroll_off + vis_w:
            scroll_off = pos - vis_w + 1
        if scroll_off < 0:
            scroll_off = 0
        stdscr.move(prompt_y, 0)
        stdscr.clrtoeol()
        try:
            stdscr.addstr(prompt_y, 0, prompt, curses.A_REVERSE)
            text = "".join(buf)
            stdscr.addstr(prompt_y, len(prompt), text[scroll_off:scroll_off + vis_w])
        except curses.error:
            pass
        screen_pos = len(prompt) + pos - scroll_off
        if 0 <= screen_pos < w:
            stdscr.move(prompt_y, screen_pos)
        stdscr.refresh()

    render()
    while True:
        c = stdscr.get_wch()
        c = ord(c) if isinstance(c, str) else c
        if c == 27:
            curses.noecho()
            curses.curs_set(0)
            return ""
        if c in (10, 13):
            break
        if c == curses.KEY_UP:
            if history and hist_idx < len(history) - 1:
                if hist_idx == -1:
                    saved_before_history = list(buf)
                hist_idx += 1
                buf = list(history[len(history) - 1 - hist_idx])
                pos = len(buf)
            render()
            continue
        if c == curses.KEY_DOWN:
            if hist_idx >= 0:
                hist_idx -= 1
                if hist_idx == -1:
                    buf = list(saved_before_history)
                else:
                    buf = list(history[len(history) - 1 - hist_idx])
                pos = len(buf)
            render()
            continue
        if c == curses.KEY_LEFT:
            if pos > 0:
                pos -= 1
            render()
            continue
        if c == curses.KEY_RIGHT:
            if pos < len(buf):
                pos += 1
            render()
            continue
        if c == curses.KEY_HOME:
            pos = 0
            render()
            continue
        if c == curses.KEY_END:
            pos = len(buf)
            render()
            continue
        if c in (curses.KEY_BACKSPACE, 127, 8):
            if pos > 0:
                buf.pop(pos - 1)
                pos -= 1
            hist_idx = -1
            render()
            continue
        if c == curses.KEY_DC:
            if pos < len(buf):
                buf.pop(pos)
            hist_idx = -1
            render()
            continue
        if c >= 32:
            buf.insert(pos, chr(c))
            pos += 1
            hist_idx = -1
            render()
            continue
        render()

    curses.noecho()
    curses.curs_set(0)
    return "".join(buf)


def run_app(stdscr, con, tables, file_paths=None):
    curses.use_default_colors()
    curses.curs_set(0)
    stdscr.nodelay(False)

    v = Viewer(con, tables, file_paths)

    while True:
        avail = v.render(stdscr)
        stdscr.refresh()

        if v.sql_mode:
            h, _ = stdscr.getmaxyx()
            sql = get_input(stdscr, h - 1, "SQL> ", v.sql_history, v.sql_prefill)
            v.sql_mode = False
            v.sql_prefill = ""
            if sql.strip():
                v.sql_history.append(sql)
            v.run_sql(sql)
            continue

        if v.status_msg:
            h, _ = stdscr.getmaxyx()
            try:
                stdscr.move(h - 1, 0)
                stdscr.clrtoeol()
                stdscr.addstr(h - 1, 0, v.status_msg[:79], curses.A_REVERSE)
            except curses.error:
                pass
            stdscr.refresh()
            curses.napms(1500)
            v.status_msg = ""

        c = stdscr.get_wch()
        c = ord(c) if isinstance(c, str) else c

        if c in (ord("q"), ord("Q"), ord("й"), ord("Й")):
            break
        elif c in (ord("v"), ord("V"), ord("м"), ord("М")):
            if v.file_paths:
                editor = os.environ.get("EDITOR", "vi")
                curses.def_prog_mode()
                curses.endwin()
                subprocess.call([editor, v.file_paths[v.idx]])
                curses.reset_prog_mode()
                curses.doupdate()
        elif c in (ord("h"), ord("H"), ord("р"), ord("Р")):
            show_help(stdscr)
        elif c in (ord("G"), ord("П")):
            v.top = max(0, v.nrows - avail)
        elif c in (ord("g"), ord("п"), curses.KEY_HOME):
            v.top = 0
        elif c == ord("/"):
            h, _ = stdscr.getmaxyx()
            term = get_input(stdscr, h - 1, "/", v.search_history).strip()
            if term:
                if not v.search_history or v.search_history[-1] != term:
                    v.search_history.append(term)
                v.do_search(term)
            else:
                v.next_match()
        elif c == ord("n") or c == ord("т"):
            v.next_match()
        elif c == ord("N") or c == ord("Т"):
            v.prev_match()
        elif c in (ord("."), ord("ю")):
            v.sql_prefill = f'from "{v.view_name}" select ' + ", ".join(f'"{c}"' for c in v.cols)
            v.sql_mode = True
        elif c == ord("\t"):  # Tab
            if len(v.tables) > 1:
                v.idx = (v.idx + 1) % len(v.tables)
                v.top = 0
                v.col_off = 0
                v.search_term = ""
                v.matches = set()
        elif c in (curses.KEY_DOWN, ord("j"), ord("о")):
            v.top = min(v.top + 1, max(0, v.nrows - 1))
        elif c in (curses.KEY_UP, ord("k"), ord("л")):
            v.top = max(v.top - 1, 0)
        elif c in (ord(" "), curses.KEY_NPAGE):
            v.top = min(v.top + avail, max(0, v.nrows - avail))
        elif c in (ord("b"), ord("и"), curses.KEY_PPAGE, 2):
            v.top = max(v.top - avail, 0)
        elif c == ord("\x0c"):  # Ctrl+L
            stdscr.clear()
        elif c == curses.KEY_END:
            v.top = max(0, v.nrows - avail)
        elif c in (curses.KEY_LEFT, curses.KEY_RIGHT):
            pass  # horizontal scroll placeholder


def main():
    parser = argparse.ArgumentParser(
        description="Interactive viewer for CSV/Parquet files (less-like, DuckDB backend)"
    )
    parser.add_argument(
        "files", nargs="+", metavar="FILE", help="CSV or Parquet files to view"
    )
    parser.add_argument(
        "-n", "--rows", type=int, default=0, help="Page size (0 = auto-fit to terminal)"
    )
    args = parser.parse_args()

    con = duckdb.connect()
    tables = []
    for i, path in enumerate(args.files):
        if not os.path.exists(path):
            print(f"dbless: {path}: No such file", file=sys.stderr)
            sys.exit(1)
        try:
            tables.append(load_table(con, path, i))
        except Exception as e:
            print(f"dbless: {path}: {e}", file=sys.stderr)
            sys.exit(1)

    curses.wrapper(run_app, con, tables, args.files)


if __name__ == "__main__":
    main()
